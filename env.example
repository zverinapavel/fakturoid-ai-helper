# =============================================================================
# Fakturoid Invoice Processor - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git!

# =============================================================================
# ANTHROPIC API (REQUIRED)
# =============================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# =============================================================================
# FAKTUROID API (REQUIRED)
# =============================================================================
# Get your credentials from: https://app.fakturoid.cz/settings/api

# Option 1: OAuth 2.0 Client Credentials (Recommended for API v3)
FAKTUROID_CLIENT_ID=your_client_id
FAKTUROID_CLIENT_SECRET=your_client_secret

# Option 2: Legacy API Key (Backward compatibility)
# If you use old API keys, uncomment these instead:
# FAKTUROID_EMAIL=your_email@example.com
# FAKTUROID_API_KEY=your_api_key

# Account slug (subdomain) - REQUIRED for both methods
FAKTUROID_ACCOUNT_SLUG=your_account_slug

# =============================================================================
# PROCESSING CONFIGURATION (OPTIONAL)
# =============================================================================
# Processing mode: manual | auto | both
# - manual: Review each invoice before submission (default)
# - auto: Automatically submit all invoices
# - both: Mixed mode
PROCESSING_MODE=manual

# Auto-submit to Fakturoid without review: true | false
# WARNING: Set to 'true' only after testing!
AUTO_SUBMIT=false

# =============================================================================
# DIRECTORIES CONFIGURATION
# =============================================================================
# Directories are configured in config/settings.yaml, NOT in .env
# To change invoice/processed directories, edit:
#   config/settings.yaml -> directories.invoices and directories.processed
# 
# Example in settings.yaml:
#   directories:
#     invoices: "data/invoices"
#     processed: "data/processed"

# =============================================================================
# LOGGING (OPTIONAL)
# =============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR
# - DEBUG: Detailed information for debugging
# - INFO: General informational messages (default)
# - WARNING: Warning messages only
# - ERROR: Error messages only
LOG_LEVEL=INFO

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# 
# Example .env for development:
#   ANTHROPIC_API_KEY=sk-ant-dev123...
#   FAKTUROID_CLIENT_ID=dev_client_id
#   FAKTUROID_CLIENT_SECRET=dev_secret
#   FAKTUROID_ACCOUNT_SLUG=mycompany
#   PROCESSING_MODE=manual
#   AUTO_SUBMIT=false
#   LOG_LEVEL=DEBUG
#
# Example .env for production:
#   ANTHROPIC_API_KEY=sk-ant-prod456...
#   FAKTUROID_CLIENT_ID=prod_client_id
#   FAKTUROID_CLIENT_SECRET=prod_secret
#   FAKTUROID_ACCOUNT_SLUG=mycompany
#   PROCESSING_MODE=auto
#   AUTO_SUBMIT=true
#   LOG_LEVEL=INFO
#
# Note: Directories are configured in config/settings.yaml, not .env

# =============================================================================
# iÚčto MIGRATION (For one-time historical data transfer)
# =============================================================================
# Only needed if migrating from iÚčto.cz
# IUCTO_API_KEY=your_iucto_api_key_here

# =============================================================================
# AI PROVIDERS - Additional Options (Optional)
# =============================================================================
# You can use different AI providers for invoice extraction

# AI Provider selection (uncomment to override settings.yaml)
# AI_PROVIDER=anthropic  # Options: anthropic, openai, deepseek, groq, ollama
# AI_MODEL=claude-sonnet-4-5-20250929

# OpenAI API Key
# OPENAI_API_KEY=sk-proj-your_openai_key_here

# DeepSeek API Key  
# DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# Groq API Key
# GROQ_API_KEY=gsk_your_groq_key_here

# Ollama (local server) - no API key needed
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# PROVIDER COMPARISON
# =============================================================================
# anthropic: Best for PDFs (native support), high quality, medium cost
# openai: Good quality, wide model selection, medium cost
# deepseek: Good quality, very low cost
# groq: Fast inference, free tier available
# ollama: Free, runs locally, requires local setup
